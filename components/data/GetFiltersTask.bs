import "pkg:/source/api/baserequest.bs"
import "pkg:/source/api/sdk.bs"
import "pkg:/source/utils/config.bs"

sub init()
    m.top.functionName = "getFiltersTask"
end sub

sub getFiltersTask()
    ' Reading m.global from a Task waits for the render thread, and the request would read the server URL twice
    cacheRequestGlobals()
    m.filters = api.items.GetFilters(m.top.params)
    m.top.filters = m.filters
end sub
