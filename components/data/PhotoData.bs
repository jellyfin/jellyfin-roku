import "pkg:/source/api/Image.bs"
import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/config.bs"

sub setFields()
    json = m.top.json

    m.top.id = json.id
    m.top.Title = json.name
    m.top.Type = "Photo"

    setPoster()
end sub

sub setPoster()
    if m.top.image <> invalid
        m.top.posterURL = m.top.image.url
    else
        m.top.posterURL = FirstItemImageURL(m.top.json, [ImageType.PRIMARY, ImageType.BACKDROP, ImageType.THUMB], imageSizes.GRID_POSTER)
        m.top.backdropURL = ItemImageURL(m.top.json, ImageType.BACKDROP, imageSizes.BACKDROP, false)
    end if
end sub
