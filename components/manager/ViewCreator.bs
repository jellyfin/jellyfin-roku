import "pkg:/source/enums/ItemType.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/enums/SubtitleSelection.bs"
import "pkg:/source/enums/TaskControl.bs"
import "pkg:/source/enums/TimerControl.bs"
import "pkg:/source/enums/TransportCommand.bs"
import "pkg:/source/enums/TransportStatus.bs"
import "pkg:/source/enums/VideoControl.bs"

const STILL_WATCHING_POPUP_TIMER_SECONDS = 60


' Play Audio
sub CreateAudioPlayerView(showAudioPlayerView = false as boolean)
    ' Receive voice transport commands
    startVoiceInputTask()

    currentItem = m.global.queueManager.callFunc("getCurrentItem")
    if not isValid(currentItem)
        stopLoadingSpinner()
        return
    end if

    audioItemChanged = m.global.audioPlayer.id <> currentItem.id
    if audioItemChanged
        m.global.audioPlayer.id = invalid
        m.global.audioPlayer.id = currentItem.id
    end if

    ' Only bypass creating an audio player view if the current queue is only audio
    if m.global.queueManager.callFunc("getQueueUniqueTypes").count() = 1
        if audioMiniPlayerIsVisible(m.top)
            if not showAudioPlayerView
                if not audioItemChanged then stopLoadingSpinner()
                return
            end if
            m.audioMiniPlayer.callFunc("setVisible", false)
        end if
    end if

    m.view = CreateObject("roSGNode", "AudioPlayerView")
    m.view.observeField("state", "onStateChange")
    m.global.sceneManager.callFunc("pushScene", m.view)
end sub

' Play Audio
sub JumpIntoAudioPlayerView()
    m.view = CreateObject("roSGNode", "AudioPlayerView")

    ' Hide the mini player
    if audioMiniPlayerIsVisible(m.view)
        m.audioMiniPlayer.callFunc("setVisible", false)
    end if

    m.view.returnOnStop = true
    m.global.sceneManager.callFunc("pushScene", m.view)
end sub

' Play Video
sub CreateVideoPlayerView()
    m.playbackData = {}
    m.selectedSubtitle = {}

    ' Hide the mini player if needed
    if audioMiniPlayerIsVisible(m.top)
        m.audioMiniPlayer.callFunc("setVisible", false)
    end if

    ' Stop active audio and release its media content before creating the video player
    if inArray([MediaPlaybackState.PLAYING, MediaPlaybackState.PAUSED, MediaPlaybackState.BUFFERING], m.global.audioPlayer.state)
        m.global.audioPlayer.control = VideoControl.STOP
        m.global.audioPlayer.content = invalid
    end if

    ' If the user has set a preferred audio track index, use it
    preferredAudioTrackIndex = m.global.queueManager.callFunc("getPreferredAudioTrackIndex")
    if preferredAudioTrackIndex < 0 then preferredAudioTrackIndex = 0

    m.global.queueManager.callFunc("setSelectedAudioStreamIndex", preferredAudioTrackIndex)

    m.view = CreateObject("roSGNode", "VideoPlayerView")
    m.view.observeField("state", "onStateChange")
    m.view.observeField("nowPlayingMetadata", "onNowPlayingMetadata")
    m.view.observeField("selectPlaybackInfoPressed", "onSelectPlaybackInfoPressed")
    m.view.observeField("selectSubtitlePressed", "onSelectSubtitlePressed")
    m.view.observeField("selectAudioPressed", "onSelectAudioPressed")
    m.view.observeField("selectSpeedPressed", "onSelectSpeedPressed")

    ' Receive voice transport commands
    startVoiceInputTask()

    mediaSourceId = m.global.queueManager.callFunc("getCurrentItem").mediaSourceId

    if not isValid(mediaSourceId) or mediaSourceId = ""
        mediaSourceId = m.global.queueManager.callFunc("getCurrentItem").id
    end if

    m.getPlaybackInfoTask = createObject("roSGNode", "GetPlaybackInfoTask")
    m.getPlaybackInfoTask.videoID = mediaSourceId
    m.getPlaybackInfoTask.observeField("data", "onPlaybackInfoLoaded")

    m.global.sceneManager.callFunc("pushScene", m.view)
end sub

' -----------------
' Event Handlers
' -----------------


' onSelectAudioPressed: Display audio selection dialog
'
sub onSelectAudioPressed()
    preferredAudioTrackName = m.global.queueManager.callFunc("getPreferredAudioTrackName")

    audioData = {
        data: []
    }

    for each item in m.view.fullAudioData
        audioStreamItem = {
            "Index": item.Index,
            "RokuTrackName": item.RokuTrackName,
            "IsExternal": item.IsExternal,
            "Track": {
                "description": item.DisplayTitle
            },
            "Type": "audioselection"
        }

        if isStringEqual(preferredAudioTrackName, string.EMPTY)
            if m.view.audioIndex = item.Index
                audioStreamItem.selected = true
            end if
        else
            if isStringEqual(item.RokuTrackName, preferredAudioTrackName)
                audioStreamItem.selected = true
            end if
        end if

        audioData.data.push(audioStreamItem)
    end for

    m.global.sceneManager.callFunc("radioDialog", tr("Select Audio"), audioData)
    m.global.sceneManager.observeField("returnData", "onSelectionMade")
end sub

' onSelectSpeedPressed: Display audio selection dialog
'
sub onSelectSpeedPressed()
    speedData = {
        data: []
    }

    speeds = [0.5, 0.75, 1, 1.5, 2, 2.5, 3]
    index = 0
    for each speed in speeds
        speedItem = {
            "Index": index,
            "Speed": speed,
            "IsExternal": false,
            "Type": "speedselection",
            "Track": {
                "description": speed
            }
        }
        index++
        if speed = m.global.sceneManager.currentSpeed
            speedItem.selected = true
        end if
        speedData.data.push(speedItem)
    end for

    m.global.sceneManager.callFunc("radioDialog", tr("Select Speed"), speedData)
    m.global.sceneManager.observeField("returnData", "onSelectionMade")
end sub

' User requested subtitle selection popup
sub onSelectSubtitlePressed()
    subtitleData = {
        data: []
    }
    selectedSubtitleIsExternal = false

    for each item in m.view.fullSubtitleData
        item.type = "subtitleselection"

        if m.view.selectedSubtitle <> SubtitleSelection.NONE
            ' Subtitle is a track within the file
            if item.index = m.view.selectedSubtitle
                item.selected = true
                selectedSubtitleIsExternal = item.LookupCI("IsExternal")
            end if
        else
            ' Subtitle is from an external source
            availableSubtitleTrackIndex = availSubtitleTrackIdx(item.track.TrackName)
            if availableSubtitleTrackIndex <> SubtitleSelection.NONE

                ' Convert Jellyfin subtitle track name to Roku track name
                subtitleFullTrackName = m.view.availableSubtitleTracks[availableSubtitleTrackIndex].TrackName

                if subtitleFullTrackName = m.view.subtitleTrack
                    item.selected = true
                    selectedSubtitleIsExternal = item.LookupCI("IsExternal")
                end if

            end if
        end if

        item.StreamIndex = item.index

        ' Put the selected item at the top of the option list
        if isValid(item.selected) and item.selected
            subtitleData.data.Unshift(item)
        else
            subtitleData.data.push(item)
        end if
    end for

    ' Manually create the None option and place at top
    subtitleData.data.Unshift({
        "Index": SubtitleSelection.NONE,
        "StreamIndex": SubtitleSelection.NONE,
        "IsExternal": false,
        "Track": {
            "description": "None"
        },
        "Type": "subtitleselection"
    })

    buttons = [tr("OK")]

    if selectedSubtitleIsExternal
        if chainLookupReturn(m.global, "session.user.settings.`playback.subs.custom`", false)
            buttons.push(tr("Adjust Subtitle Timing"))
        end if
    end if

    m.global.sceneManager.callFunc("radioDialog", tr("Select Subtitles"), subtitleData, buttons)
    m.global.sceneManager.observeField("returnData", "onSelectionMade")
end sub

' User has selected something from the radioDialog popup
sub onSelectionMade()
    m.global.sceneManager.unobserveField("returnData")

    if not isValid(m.global.sceneManager.returnData) then return
    if not isValid(m.global.sceneManager.returnData.type) then return

    if LCase(m.global.sceneManager.returnData.type) = "subtitleselection"
        processSubtitleSelection()
        return
    end if

    if LCase(m.global.sceneManager.returnData.type) = "audioselection"
        processAudioSelection()
        return
    end if

    if isStringEqual(chainLookup(m.global.sceneManager, "returnData.type"), "speedselection")
        processSpeedSelection()
        return
    end if
end sub


' processAudioSelection: Audio track selection handler
'
sub processAudioSelection()
    selectedAudioTrack = m.global.sceneManager.returnData

    if not isChainValid(selectedAudioTrack, "index") then return

    m.global.queueManager.callFunc("setPreferredAudioTrackName", selectedAudioTrack.LookupCI("RokuTrackName"))

    for each audioTrack in m.view.availableAudioTracks
        if isStringEqual(audioTrack.LookupCI("name"), selectedAudioTrack.LookupCI("RokuTrackName"))
            m.global.queueManager.callFunc("setPreferredAudioTrackIndex", audioTrack.LookupCI("Track").toint())
            m.view.audioIndex = audioTrack.LookupCI("Track").toint()
            return
        end if
    end for

    m.global.queueManager.callFunc("setPreferredAudioTrackIndex", selectedAudioTrack.index)
    m.view.audioIndex = selectedAudioTrack.index
end sub

' processSpeedSelection: Speed selection handler
'
sub processSpeedSelection()
    selectedSpeed = chainLookupReturn(m.global.sceneManager, "returnData", { speed: 1 })

    m.global.sceneManager.currentSpeed = selectedSpeed.speed
    m.view.selectedSpeed = selectedSpeed.speed
end sub

sub processSubtitleSelection()
    m.selectedSubtitle = m.global.sceneManager.returnData

    ' The selected encoded subtitle did not change.
    if m.view.selectedSubtitle <> SubtitleSelection.NONE or m.selectedSubtitle.index <> SubtitleSelection.NONE
        if m.view.selectedSubtitle = m.selectedSubtitle.index then return
    end if

    ' The playbackData is now outdated and must be refreshed
    m.playbackData = invalid

    ' Find previously selected subtitle and identify if it was encoded
    for each item in m.view.fullSubtitleData
        if item.index = m.view.selectedSubtitle
            m.view.previousSubtitleWasEncoded = item.IsEncoded
            exit for
        end if
    end for

    if LCase(m.selectedSubtitle.track.description) = "none"
        m.view.globalCaptionMode = "Off"
        m.view.subtitleTrack = ""

        if m.view.selectedSubtitle <> SubtitleSelection.NONE
            m.view.selectedSubtitle = SubtitleSelection.NONE
        end if

        m.global.queueManager.callFunc("setPreferredSubtitleTrack", m.selectedSubtitle)
        return
    end if

    if m.selectedSubtitle.IsEncoded
        ' Roku can not natively display these subtitles, so turn off the caption mode on the device
        m.view.globalCaptionMode = "Off"
    else
        ' Roku can natively display these subtitles, ensure the caption mode on the device is on
        m.view.globalCaptionMode = "On"

        ' Roku may rearrange subtitle tracks. Look up track based on name to ensure we get the correct index
        availableSubtitleTrackIndex = availSubtitleTrackIdx(m.selectedSubtitle.Track.TrackName)
        if availableSubtitleTrackIndex = SubtitleSelection.NONE then return

        m.view.subtitleTrack = m.view.availableSubtitleTracks[availableSubtitleTrackIndex].TrackName
    end if

    m.global.queueManager.callFunc("setPreferredSubtitleTrack", m.selectedSubtitle)
    m.view.selectedSubtitle = m.selectedSubtitle.Index
end sub

' User requested playback info
sub onSelectPlaybackInfoPressed()
    ' Check if we already have playback info and show it in a popup
    if isValid(m.playbackData) and isValid(m.playbackData.playbackinfo)
        m.global.sceneManager.callFunc("standardDialog", tr("Playback Info"), m.playbackData.playbackinfo)
        return
    end if

    m.getPlaybackInfoTask.control = TaskControl.RUN
end sub

' The playback info task has returned data
sub onPlaybackInfoLoaded()
    m.playbackData = m.getPlaybackInfoTask.data

    ' Check if we have playback info and show it in a popup
    if isValid(m.playbackData) and isValid(m.playbackData.playbackinfo)
        m.global.sceneManager.callFunc("standardDialog", tr("Playback Info"), m.playbackData.playbackinfo)
    end if
end sub

' Playback state change event handlers
sub onStateChange()
    ' Ignore errors, they are handled inside VideoPlayerView.bs
    if m.view.errorCode <> 0
        return
    end if

    if LCase(m.view.state) = "finished"
        if isValid(m.view.returnOnStop)
            if m.view.returnOnStop then return
        end if

        ' Close any open dialogs
        if m.global.sceneManager.callFunc("isDialogOpen")
            m.global.sceneManager.callFunc("dismissDialog")
        end if

        ' Check if user chose not to continue to next episode
        currentView = m.global.sceneManager.callFunc("getActiveScene")
        if isChainValid(currentView, "disableNextEpisodeAutoPlay")
            if currentView.disableNextEpisodeAutoPlay
                m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
                m.global.queueManager.callFunc("clear")

                ' Playback ended: nothing is playing now
                clearNowPlaying()

                ' Playback completed, return user to previous screen
                m.global.sceneManager.callFunc("popScene")
                m.global.audioPlayer.loopMode = ""
            end if
        end if

        ' If there is something next in the queue, play it
        if m.global.queueManager.callFunc("getPosition") < m.global.queueManager.callFunc("getCount") - 1
            stillwatchingPopupInactivityTime = chainLookupReturn(m.global.session, "user.settings.stillwatchingPopupInactivityTime", "0")
            if stillwatchingPopupInactivityTime <> "0"
                stillwatchingPopupInactivityTime = stillwatchingPopupInactivityTime.ToInt()
                m.deviceInfo = CreateObject("roDeviceInfo")

                if m.deviceInfo.TimeSinceLastKeypress() >= (stillwatchingPopupInactivityTime * 60)
                    m.stillWatchingTimer = createObject("roSGNode", "Timer")
                    m.stillWatchingTimer.repeat = false
                    m.stillWatchingTimer.duration = STILL_WATCHING_POPUP_TIMER_SECONDS
                    m.stillWatchingTimer.observeField("fire", "stillWatchingTimerComplete")
                    m.stillWatchingTimer.control = TimerControl.START

                    m.global.sceneManager.callFunc("optionDialog", "stillwatching", tr("Are You Still Watching?"), [tr("Playback will automatically stop in 1 minute if no buttons are pressed.")], [tr("Yes, continue"), tr("No, stop playback")], {})
                    return
                end if
            end if

            m.global.sceneManager.callFunc("clearPreviousScene")
            m.global.queueManager.callFunc("moveForward")
            m.global.queueManager.callFunc("playQueue")
            return
        end if

        episodeToShowAtFinish = string.EMPTY
        gotoNextEpisodeAfterCurrentEnds = chainLookupReturn(m.global.session, "user.settings.`playback.showNextUpAfterFinish`", false)
        if gotoNextEpisodeAfterCurrentEnds
            episodeToShowAtFinish = m.global.queueManager.callFunc("getEpisodeToShowAtFinish")
        end if

        m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
        m.global.queueManager.callFunc("clear")

        if isValidAndNotEmpty(episodeToShowAtFinish)
            m.global.queueManager.callFunc("setLastKnownItemID", episodeToShowAtFinish.LookupCI("id"))
        end if

        ' Playback ended: nothing is playing now
        clearNowPlaying()

        ' Playback completed, return user to previous screen
        m.global.sceneManager.callFunc("popScene")
        m.global.audioPlayer.loopMode = ""
    else if LCase(m.view.state) = "stopped"
        clearNowPlaying()
    end if
end sub

sub stillWatchingTimerComplete()
    m.stillWatchingTimer.control = TimerControl.STOP

    ' Check if user pressed a button before the timer fired
    if m.deviceInfo.TimeSinceLastKeypress() <= STILL_WATCHING_POPUP_TIMER_SECONDS then return

    if m.global.sceneManager.callFunc("isDialogOpen")
        m.global.sceneManager.callFunc("dismissDialog")
    end if

    m.global.queueManager.callFunc("bypassNextPreferredAudioTrackIndexReset")
    m.global.queueManager.callFunc("clear")

    ' Playback ended: nothing is playing now
    clearNowPlaying()
    m.global.sceneManager.callFunc("popScene")
end sub

' Roku translates the info provided in subtitleTracks into availableSubtitleTracks
' Including ignoring tracks, if they are not understood, thus making indexing unpredictable.
' This function translates between our internel selected subtitle index
' and the corresponding index in availableSubtitleTracks.
function availSubtitleTrackIdx(tracknameToFind as string) as integer
    idx = 0
    for each availTrack in m.view.availableSubtitleTracks
        ' The TrackName must contain the URL we supplied originally, though
        ' Roku mangles the name a bit, so we check if the URL is a substring, rather
        ' than strict equality
        if Instr(1, availTrack.TrackName, tracknameToFind)
            return idx
        end if
        idx = idx + 1
    end for
    return SubtitleSelection.NONE
end function

function audioMiniPlayerIsVisible(baseNode as dynamic) as boolean
    m.audioMiniPlayer = invalid

    scene = baseNode.getScene()
    if not isValid(scene) then return false

    m.audioMiniPlayer = scene.findNode("audioMiniPlayer")
    if not isValid(m.audioMiniPlayer) then return false

    return m.audioMiniPlayer.callFunc("isVisible")
end function

' Roku Voice and transport commands (https://developer.roku.com/dev/docs/transport-controls):
' Basic (play, pause, forward, rewind, replay, OK), Enhanced (start over, seek, next) and
' Additional enhanced (now playing, skip, shuffle, loop, like, dislike).
'
' VoiceInputTask receives the commands from Roku OS. They are handled here for whichever player is
' active: the video player when it is on screen, otherwise the audio player.
' Every command gets a response (TransportStatus), which Roku OS requires within 5 seconds.

' How far the audio forward and rewind commands move, in seconds
const VOICE_AUDIO_SKIP_SECONDS = 30
' How far the replay command moves back, in seconds (the same as the replay key)
const VOICE_REPLAY_SECONDS = 10
' How close to the end a seek past the end lands, in seconds
const VOICE_SEEK_END_MARGIN_SECONDS = 30

' startVoiceInputTask: Starts listening for voice commands, if not already listening.
' The task keeps running for the rest of the session, so voice commands keep working when playback
' restarts (such as after changing audio or subtitle tracks) and between video and audio playback.
'
sub startVoiceInputTask()
    if isValid(m.voiceInputTask) then return

    m.voiceInputTask = CreateObject("roSGNode", "VoiceInputTask")
    m.voiceInputTask.observeField("inputData", "onVoiceInputData")
    m.voiceInputTask.control = TaskControl.RUN
end sub

' clearNowPlaying: Tells Roku OS that nothing is playing (used when playback ends)
'
sub clearNowPlaying()
    if not isValid(m.voiceInputTask) then return
    m.voiceInputTask.nowPlayingData = { title: string.EMPTY, contentType: string.EMPTY }
end sub

' onVoiceInputData: Called when VoiceInputTask receives a voice or transport command.
' Handles the command, then sends the response back to Roku OS.
'
sub onVoiceInputData()
    data = m.voiceInputTask.inputData
    if not isChainValid(data, "type") then return

    ret = handleTransportCommand(data)

    ' Now Playing metadata must reach Roku OS before the response
    if isValid(ret.nowPlaying)
        m.voiceInputTask.nowPlayingData = ret.nowPlaying
    end if

    if isChainValid(data, "id")
        response = { id: data.id, status: ret.status }
        if isValid(ret.metadata) then response.metadata = ret.metadata
        m.voiceInputTask.transportResponse = response
    end if
end sub

' Forward Now Playing metadata from VideoPlayerView to VoiceInputTask.
' VoiceInputTask calls roAppManager on its own thread since it cannot be called from render thread.
sub onNowPlayingMetadata()
    if not isValid(m.voiceInputTask) then return
    m.voiceInputTask.nowPlayingData = m.view.nowPlayingMetadata
end sub

' handleTransportCommand: Handles a voice or transport command for the active player.
'
' @param {object} data - inputData from VoiceInputTask
' @return {object} { status, nowPlaying?, metadata? }, where status is a TransportStatus value
function handleTransportCommand(data as object) as object
    activeScene = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(activeScene) and activeScene.isSubType("VideoPlayerView")
        return handleVideoTransportCommand(activeScene, data)
    end if

    if isAudioLoaded()
        return handleAudioTransportCommand(data)
    end if

    ' Nothing is playing: let Roku OS respond
    return { status: TransportStatus.UNHANDLED }
end function

' getTransportCommand: Returns the lower case command name, or the seek type for absolute seeks
'
function getTransportCommand(data as object) as string
    if isStringEqual(data.type, TransportCommand.SEEK) then return TransportCommand.SEEK
    if not isStringEqual(data.type, "transport") then return string.EMPTY
    return LCase(chainLookupReturn(data, "command", string.EMPTY))
end function

' getVoiceSeekPosition: Returns where a seek command would go, in seconds
'
' @param {object} data - inputData: position (absolute seek), or duration and direction (relative seek)
' @param {float} position - the current position in seconds
function getVoiceSeekPosition(data as object, position as float) as float
    if isValid(data.position) then return data.position

    offset = Val(chainLookupReturn(data, "duration", "0"))
    if isStringEqual(data.direction, "backward") then return position - offset
    return position + offset
end function

' getSeekTarget: Returns where a seek should go, kept within the media, and its status
'
' @param {float} newPosition - where the seek would go, in seconds
' @param {float} duration - the length of the media in seconds
' @return {object} { position, status }
function getSeekTarget(newPosition as float, duration as float) as object
    if newPosition < 0 then return { position: 0, status: TransportStatus.SUCCESS_SEEK_START }

    if duration > 0 and newPosition > duration
        endPosition = duration - VOICE_SEEK_END_MARGIN_SECONDS
        if endPosition < 0 then endPosition = 0
        return { position: endPosition, status: TransportStatus.SUCCESS_SEEK_END }
    end if

    return { position: newPosition, status: TransportStatus.SUCCESS }
end function

' handleVideoTransportCommand: Handles a command while the video player is on screen
'
' @param {object} videoPlayer - the VideoPlayerView
' @param {object} data - inputData from VoiceInputTask
' @return {object} see handleTransportCommand
function handleVideoTransportCommand(videoPlayer as object, data as object) as object
    cmd = getTransportCommand(data)
    isLive = isChainValid(videoPlayer, "content.live") and videoPlayer.content.live

    if isStringEqual(cmd, TransportCommand.STARTOVER)
        if isLive then return { status: TransportStatus.ERROR_LIVE }
        videoPlayer.voiceCommand = { type: TransportCommand.SEEK, position: 0 }
        return { status: TransportStatus.SUCCESS }
    end if

    if isStringEqual(cmd, TransportCommand.SEEK)
        target = getSeekTarget(getVoiceSeekPosition(data, videoPlayer.position), videoPlayer.duration)
        videoPlayer.voiceCommand = { type: TransportCommand.SEEK, position: target.position }
        return { status: target.status }
    end if

    if inArray([TransportCommand.PLAY, TransportCommand.RESUME], cmd)
        if isStringEqual(videoPlayer.state, MediaPlaybackState.PLAYING) then return { status: TransportStatus.ERROR_REDUNDANT }
        videoPlayer.voiceCommand = { type: TransportCommand.PLAY }
        return { status: TransportStatus.SUCCESS }
    end if

    if inArray([TransportCommand.PAUSE, TransportCommand.STOP], cmd)
        if isStringEqual(videoPlayer.state, MediaPlaybackState.PAUSED) then return { status: TransportStatus.ERROR_REDUNDANT }
        videoPlayer.voiceCommand = { type: TransportCommand.PAUSE }
        return { status: TransportStatus.SUCCESS }
    end if

    if isStringEqual(cmd, TransportCommand.PLAYPAUSE)
        videoPlayer.voiceCommand = { type: TransportCommand.PLAYPAUSE }
        return { status: TransportStatus.SUCCESS }
    end if

    if inArray([TransportCommand.FORWARD, TransportCommand.FASTFORWARD, TransportCommand.FF], cmd)
        ' Skip an intro or recap; otherwise fast forward, the same as the fast forward key
        if videoPlayer.hasActiveSegment
            videoPlayer.voiceCommand = { type: TransportCommand.SKIP }
        else
            videoPlayer.voiceCommand = { type: "key", key: KeyCode.FASTFORWRD }
        end if
        return { status: TransportStatus.SUCCESS }
    end if

    ' Rewind, the same as the rewind key (say "play" to stop rewinding)
    if inArray([TransportCommand.REWIND, TransportCommand.RW], cmd)
        videoPlayer.voiceCommand = { type: "key", key: KeyCode.REWIND }
        return { status: TransportStatus.SUCCESS }
    end if

    ' Replay, the same as the replay key: back 10 seconds
    if isStringEqual(cmd, TransportCommand.REPLAY)
        videoPlayer.voiceCommand = { type: "key", key: KeyCode.REPLAY }
        return { status: TransportStatus.SUCCESS }
    end if

    if inArray([TransportCommand.NEXT_ITEM, TransportCommand.SKIP], cmd)
        ' Skip an intro or recap, otherwise play the next item
        if videoPlayer.hasActiveSegment
            videoPlayer.voiceCommand = { type: TransportCommand.SKIP }
            return { status: TransportStatus.SUCCESS }
        end if
        return playNextVideo()
    end if

    if isStringEqual(cmd, TransportCommand.NOWPLAYING)
        ' The metadata was sent to Roku OS when playback started
        if isValid(m.global.queueManager.callFunc("getCurrentItem")) then return { status: TransportStatus.SUCCESS }
        return { status: TransportStatus.ERROR_GENERIC }
    end if

    if inArray([TransportCommand.LIKE, TransportCommand.DISLIKE], cmd)
        return setCurrentItemFavorite(isStringEqual(cmd, TransportCommand.LIKE))
    end if

    ' Videos can't be shuffled or repeated
    if inArray([TransportCommand.SHUFFLE, TransportCommand.LOOP], cmd)
        return { status: TransportStatus.ERROR_GENERIC }
    end if

    ' OK: Roku OS sends the key
    return { status: TransportStatus.UNHANDLED }
end function

' playNextVideo: Plays the next item in the queue
'
' @return {object} see handleTransportCommand
function playNextVideo() as object
    queueManager = m.global.queueManager
    if queueManager.callFunc("getPosition") >= queueManager.callFunc("getCount") - 1
        return { status: TransportStatus.ERROR_GENERIC }
    end if

    m.global.sceneManager.callFunc("clearPreviousScene")
    queueManager.callFunc("moveForward")
    queueManager.callFunc("playQueue")
    return { status: TransportStatus.SUCCESS }
end function

' isAudioLoaded: Returns true if the audio player has a song loaded (playing, paused or buffering)
'
function isAudioLoaded() as boolean
    return inArray([MediaPlaybackState.PLAYING, MediaPlaybackState.PAUSED, MediaPlaybackState.BUFFERING], m.global.audioPlayer.state)
end function

' handleAudioTransportCommand: Handles a command while audio is playing, in the audio player or the mini player
'
' @param {object} data - inputData from VoiceInputTask
' @return {object} see handleTransportCommand
function handleAudioTransportCommand(data as object) as object
    cmd = getTransportCommand(data)
    audioPlayer = m.global.audioPlayer
    queueManager = m.global.queueManager

    if inArray([TransportCommand.PLAY, TransportCommand.RESUME], cmd)
        if isStringEqual(audioPlayer.state, MediaPlaybackState.PLAYING) then return { status: TransportStatus.ERROR_REDUNDANT }
        audioPlayer.control = VideoControl.RESUME
        return { status: TransportStatus.SUCCESS }
    end if

    if inArray([TransportCommand.PAUSE, TransportCommand.STOP], cmd)
        if isStringEqual(audioPlayer.state, MediaPlaybackState.PAUSED) then return { status: TransportStatus.ERROR_REDUNDANT }
        audioPlayer.control = VideoControl.PAUSE
        return { status: TransportStatus.SUCCESS }
    end if

    if isStringEqual(cmd, TransportCommand.PLAYPAUSE)
        if isStringEqual(audioPlayer.state, MediaPlaybackState.PAUSED)
            audioPlayer.control = VideoControl.RESUME
        else
            audioPlayer.control = VideoControl.PAUSE
        end if
        return { status: TransportStatus.SUCCESS }
    end if

    ' Forward, rewind and replay move within the song. (On the audio player screen, the
    ' fast forward and rewind keys change songs instead; "next" does that by voice.)
    if inArray([TransportCommand.FORWARD, TransportCommand.FASTFORWARD, TransportCommand.FF], cmd)
        return seekAudio(audioPlayer.position + VOICE_AUDIO_SKIP_SECONDS)
    end if

    if inArray([TransportCommand.REWIND, TransportCommand.RW], cmd)
        return seekAudio(audioPlayer.position - VOICE_AUDIO_SKIP_SECONDS)
    end if

    if isStringEqual(cmd, TransportCommand.REPLAY)
        return seekAudio(audioPlayer.position - VOICE_REPLAY_SECONDS)
    end if

    if isStringEqual(cmd, TransportCommand.STARTOVER)
        return seekAudio(0)
    end if

    if isStringEqual(cmd, TransportCommand.SEEK)
        return seekAudio(getVoiceSeekPosition(data, audioPlayer.position))
    end if

    if inArray([TransportCommand.NEXT_ITEM, TransportCommand.SKIP], cmd)
        if queueManager.callFunc("getPosition") >= queueManager.callFunc("getCount") - 1
            return { status: TransportStatus.ERROR_GENERIC }
        end if
        audioPlayer.callFunc("playNext")
        return { status: TransportStatus.SUCCESS }
    end if

    if isStringEqual(cmd, TransportCommand.NOWPLAYING)
        nowPlaying = getAudioNowPlaying()
        if not isValid(nowPlaying) then return { status: TransportStatus.ERROR_GENERIC }
        return { status: TransportStatus.SUCCESS, nowPlaying: nowPlaying }
    end if

    if isStringEqual(cmd, TransportCommand.SHUFFLE)
        return shuffleAudio()
    end if

    if isStringEqual(cmd, TransportCommand.LOOP)
        return loopAudio()
    end if

    if inArray([TransportCommand.LIKE, TransportCommand.DISLIKE], cmd)
        ret = setCurrentItemFavorite(isStringEqual(cmd, TransportCommand.LIKE))
        song = queueManager.callFunc("getCurrentItem")
        if isStringEqual(ret.status, TransportStatus.SUCCESS)
            ' Shown by Roku OS with the response
            ret.metadata = { music_track: getSongName(song), music_artist: getSongArtist(song) }
        end if
        return ret
    end if

    ' OK: Roku OS sends the key
    return { status: TransportStatus.UNHANDLED }
end function

' seekAudio: Seeks the audio player
'
' @param {float} newPosition - where to seek to, in seconds
' @return {object} see handleTransportCommand
function seekAudio(newPosition as float) as object
    audioPlayer = m.global.audioPlayer
    target = getSeekTarget(newPosition, audioPlayer.duration)
    audioPlayer.seek = target.position
    return { status: target.status }
end function

' shuffleAudio: Turns on shuffle for the audio queue, the same as the audio player's shuffle button
'
' @return {object} see handleTransportCommand
function shuffleAudio() as object
    queueManager = m.global.queueManager

    ' The audio player has no shuffle for a single song or a mixed audio and video queue
    if queueManager.callFunc("getCount") < 2 then return { status: TransportStatus.ERROR_GENERIC }
    if queueManager.callFunc("getQueueUniqueTypes").count() > 1 then return { status: TransportStatus.ERROR_GENERIC }
    if queueManager.callFunc("getIsShuffled") then return { status: TransportStatus.ERROR_REDUNDANT }

    ' Shuffling keeps the current song first, so it keeps playing
    activeScene = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(activeScene) and activeScene.isSubType("AudioPlayerView")
        ' Also updates the shuffle icon and track number
        activeScene.callFunc("setShuffle", true)
    else
        queueManager.callFunc("toggleShuffle")
        queueManager.callFunc("setPosition", 0)
    end if

    return { status: TransportStatus.SUCCESS }
end function

' loopAudio: Turns on repeat: the whole queue, or the song if it is the only one
'
' @return {object} see handleTransportCommand
function loopAudio() as object
    audioPlayer = m.global.audioPlayer
    queueManager = m.global.queueManager

    ' The audio player has no repeat for a mixed audio and video queue
    if queueManager.callFunc("getQueueUniqueTypes").count() > 1 then return { status: TransportStatus.ERROR_GENERIC }
    if isValidAndNotEmpty(audioPlayer.loopMode) then return { status: TransportStatus.ERROR_REDUNDANT }

    ' The audio player view updates its repeat icon when loopMode changes
    if queueManager.callFunc("getCount") > 1
        audioPlayer.loopMode = "all"
    else
        audioPlayer.loopMode = "one"
    end if

    return { status: TransportStatus.SUCCESS }
end function

' getAudioNowPlaying: Returns Now Playing metadata for the current song, or invalid
'
function getAudioNowPlaying() as dynamic
    song = m.global.queueManager.callFunc("getCurrentItem")
    if not isValid(song) then return invalid

    title = getSongName(song)
    artist = getSongArtist(song)
    if isValidAndNotEmpty(artist) then title = `${title} - ${artist}`

    return { title: title, contentType: "audio" }
end function

' getQueueItemJson: Returns the server's data for a queue item. Some queue items keep it in a json field,
' others are the server's data.
'
function getQueueItemJson(item as dynamic) as dynamic
    json = chainLookup(item, "json")
    if type(json) = "roAssociativeArray" then return json
    return item
end function

' getSongName: Returns the name of a song queue item
'
function getSongName(song as object) as string
    return chainLookupReturn(getQueueItemJson(song), "Name", chainLookupReturn(song, "title", string.EMPTY))
end function

' getSongArtist: Returns the artist of a song queue item
'
function getSongArtist(song as object) as string
    json = getQueueItemJson(song)
    artists = chainLookup(json, "Artists")
    if isValidAndNotEmpty(artists) and type(artists) = "roArray" then return artists.join(", ")
    return chainLookupReturn(json, "AlbumArtist", string.EMPTY)
end function

' setCurrentItemFavorite: Adds the current item to the user's favorites (like), or removes it (dislike)
'
' @param {boolean} isFavorite - true to add, false to remove
' @return {object} see handleTransportCommand
function setCurrentItemFavorite(isFavorite as boolean) as object
    itemId = chainLookup(m.global.queueManager.callFunc("getCurrentItem"), "id")
    if not isValidAndNotEmpty(itemId) then return { status: TransportStatus.ERROR_GENERIC }

    ' The request is made from a task: the render thread can't make network requests
    m.voiceFavoriteTask = CreateObject("roSGNode", "FavoriteItemsTask")
    m.voiceFavoriteTask.itemId = itemId
    m.voiceFavoriteTask.favTask = isFavorite ? "Favorite" : "Unfavorite"
    m.voiceFavoriteTask.control = TaskControl.RUN

    return { status: TransportStatus.SUCCESS }
end function
