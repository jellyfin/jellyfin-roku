import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/config.bs"

sub init()
    m.top.functionName = "PlaystateLoop"
end sub

' Runs for as long as the app does, sending each report set on the report field in turn.
' Reports used to restart the task, so a report made while the previous one was still being sent
' (for example, a start right after a stop) was lost.
sub PlaystateLoop()
    port = CreateObject("roMessagePort")
    m.top.observeField("report", port)

    while true
        msg = wait(0, port)
        if type(msg) = "roSGNodeEvent"
            report = msg.getData()
            if isValid(report) then PlaystateUpdate(report.status, report.params)
        end if
    end while
end sub

sub PlaystateUpdate(status as dynamic, params as dynamic)
    if status = "start"
        url = "Sessions/Playing"
    else if status = "stop"
        url = "Sessions/Playing/Stopped"
    else if status = "update"
        url = "Sessions/Playing/Progress"
    else
        ' Unknown State
        return
    end if
    if not isValid(params) then params = {}
    resp = APIRequest(url)
    postJson(resp, PlaystateDefaults(params))
end sub

function PlaystateDefaults(params = {} as object)
    new_params = {
        '"CanSeek": false
        '"Item": "{}", ' TODO!
        '"NowPlayingQueue": "[]", ' TODO!
        '"PlaylistItemId": "",
        '"ItemId": id,
        '"SessionId": "", ' TODO!
        '"MediaSourceId": id,
        '"AudioStreamIndex": 1,
        '"SubtitleStreamIndex": 0,
        "IsPaused": false,
        '"IsMuted": false,
        "PositionTicks": 0
        '"PlaybackStartTimeTicks": 0,
        '"VolumeLevel": 100,
        '"Brightness": 100,
        '"AspectRatio": "16x9",
        '"PlayMethod": "DirectStream"
        '"LiveStreamId": "",
        '"PlaySessionId": "",
        '"RepeatMode": "RepeatNone"
    }

    paramsArray = params.items()
    for i = 0 to paramsArray.count() - 1
        item = paramsArray[i]
        new_params[item.key] = item.value
    end for
    return FormatJson(new_params)
end function
