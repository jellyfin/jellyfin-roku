import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.functionName = "PlaystateUpdate"
end sub

sub PlaystateUpdate()
    if m.top.status = "start"
        url = "Sessions/Playing"
    else if m.top.status = "stop" or m.top.status = "suspend"
        url = "Sessions/Playing/Stopped"
    else if m.top.status = "update" or m.top.status = "pause"
        url = "Sessions/Playing/Progress"
    else
        ' Unknown State
        return
    end if
    params = PlaystateDefaults(m.top.params)
    resp = APIRequest(url)
    postJson(resp, params)

    if m.top.status = "suspend" or m.top.status = "pause" then saveResumePoint(m.top.params)
end sub

' saveResumePoint: Saves the position as the item's resume point, which the server doesn't do below
' its minimum resume percentage. Items the server marked played are left alone.
'
' @param {object} params - the playstate params, with ItemId and PositionTicks
sub saveResumePoint(params as object)
    url = `UserItems/${params.ItemId}/UserData`
    userData = getJson(APIRequest(url))
    if not isValid(userData) or userData.Played = true then return

    postJson(APIRequest(url), FormatJson({ "PlaybackPositionTicks": params.PositionTicks }))
end sub

function PlaystateDefaults(params = {} as object)
    new_params = {
        '"CanSeek": false
        '"Item": "{}", ' TODO!
        '"NowPlayingQueue": "[]", ' TODO!
        '"PlaylistItemId": "",
        '"ItemId": id,
        '"SessionId": "", ' TODO!
        '"MediaSourceId": id,
        '"AudioStreamIndex": 1,
        '"SubtitleStreamIndex": 0,
        "IsPaused": false,
        '"IsMuted": false,
        "PositionTicks": 0
        '"PlaybackStartTimeTicks": 0,
        '"VolumeLevel": 100,
        '"Brightness": 100,
        '"AspectRatio": "16x9",
        '"PlayMethod": "DirectStream"
        '"LiveStreamId": "",
        '"PlaySessionId": "",
        '"RepeatMode": "RepeatNone"
    }

    paramsArray = params.items()
    for i = 0 to paramsArray.count() - 1
        item = paramsArray[i]
        new_params[item.key] = item.value
    end for
    return FormatJson(new_params)
end function
