import "pkg:/source/enums/ColorPalette.bs"
import "pkg:/source/enums/KeyCode.bs"
import "pkg:/source/enums/MediaPlaybackState.bs"
import "pkg:/source/enums/String.bs"
import "pkg:/source/enums/VideoControl.bs"
import "pkg:/source/utils/misc.bs"

sub init()
    m.top.backgroundURI = ""
    m.spinner = m.top.findNode("spinner")

    ' Instant Resume: let tasks finish reporting playback progress after the app is suspended
    m.top.allowBackgroundTask = true
end sub

' onAppSuspend: Instant Resume suspend handler. Roku OS calls this when the user leaves the app
' (Home button, or Back out of the app) or the system screensaver starts. The app stays in memory
' but loses the video decoder and, once this returns, its graphics.
'
' @param {dynamic} arg - lastSuspendOrResumeReason is "home" or "screensaver"
sub onAppSuspend(arg as dynamic)
    reason = chainLookupReturn(arg, "lastSuspendOrResumeReason", string.EMPTY)
    print "App suspended: " reason

    stopPlaybackForSuspend()
end sub

' onAppResume: Instant Resume resume handler. Roku OS calls this when the user returns to the app.
'
' @param {dynamic} arg - lastSuspendOrResumeReason, plus launchParams (contentId, mediaType) when resumed with a deep link
sub onAppResume(arg as dynamic)
    reason = chainLookupReturn(arg, "lastSuspendOrResumeReason", string.EMPTY)
    print "App resumed: " reason

    ' Must be set again after every resume to get background tasks on the next suspend
    m.top.allowBackgroundTask = true

    launchParams = chainLookup(arg, "launchParams")
    hasDeepLink = isChainValid(launchParams, "contentId") and isChainValid(launchParams, "mediaType")
    if not hasDeepLink then launchParams = {}

    ' The main thread checks the session is still valid, reconnects and handles any deep link
    m.top.resumed = { reason: reason, launchParams: launchParams }

    ' With a deep link, the main thread signals the beacon once it has started playback
    if hasDeepLink then return

    ' Roku OS only times resumes from Home; resuming from the screensaver has no beacon to complete
    signalBeacon = not isStringEqual(reason, "screensaver")

    ' Restart a video stopped on suspend; the player signals the beacon once it plays again
    activeScene = m.global.sceneManager.callFunc("getActiveScene")
    if isValid(activeScene) and activeScene.isSubType("VideoPlayerView")
        if activeScene.callFunc("resumePlayer", signalBeacon) then return
    end if

    ' The screen the user left is still in place, so the app is ready to use
    if signalBeacon then m.top.signalBeacon("AppResumeComplete")
end sub

' stopPlaybackForSuspend: Stops playback, which can't continue while suspended, and reports the
' position to the server. Video restarts from that position on resume; audio stays stopped.
'
sub stopPlaybackForSuspend()
    sceneManager = m.global.sceneManager
    if not isValid(sceneManager) then return

    activeScene = sceneManager.callFunc("getActiveScene")
    if isValid(activeScene) and activeScene.isSubType("VideoPlayerView")
        activeScene.callFunc("suspendPlayer")
        return
    end if

    audioPlayer = m.global.audioPlayer
    if not isValid(audioPlayer) then return
    if not inArray([MediaPlaybackState.PLAYING, MediaPlaybackState.PAUSED, MediaPlaybackState.BUFFERING], audioPlayer.state) then return

    ' Report before the queue is cleared: the report needs the current queue item
    audioPlayer.callFunc("reportStopped")

    if isValid(activeScene) and activeScene.isSubType("AudioPlayerView")
        activeScene.callFunc("closePlayer")
    else
        m.global.queueManager.callFunc("clear")
        audioPlayer.control = VideoControl.STOP
    end if

    audioMiniPlayer = m.top.findNode("audioMiniPlayer")
    if isValid(audioMiniPlayer) then audioMiniPlayer.callFunc("setVisible", false)
end sub

' Triggered when the isLoading boolean component field is changed
sub isLoadingChanged()
    m.spinner.visible = m.top.isLoading
end sub

sub setBackgroundImage(backgroundURI as string)
    imageBackground = m.top.findNode("imageBackground")
    if not isValid(imageBackground) then return

    imageBackground.uri = backgroundURI
end sub

sub onJumpToChange()
    if not isValidAndNotEmpty(m.top.jumpTo) then return
    if not isValid(m.top.jumpTo.selectiontype) then return

    m.global.jumpTo = m.top.jumpTo
    m.top.jumpTo = {}
end sub

' Triggered when the disableRemote boolean component field is changed
sub disableRemoteChanged()
    if m.top.disableRemote
        dialog = createObject("roSGNode", "ProgressDialog")
        dialog.id = "invisibiledialog"
        dialog.visible = false
        dialog.opacity = 0
        m.top.dialog = dialog
    else
        if isValid(m.top.dialog)
            m.top.dialog.close = true
        end if
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "back"
        confirmExit = chainLookupReturn(m.global.session, "user.settings.`global.confirmexit`", false)
        if confirmExit
            activeScene = m.global.sceneManager.callFunc("getActiveScene")
            if isValid(activeScene) and activeScene.isSubType("Home")
                m.global.sceneManager.callFunc("optionDialog", "confirmexit", tr("Confirm Exit"), [tr("Are you sure you want to exit Jellyfin?")], [tr("No, Cancel"), tr("Yes")], {})
                return true
            end if
        end if

        ' Leave Back on the last screen to Roku OS, which closes the app or, with Instant Resume, suspends it
        if m.global.sceneManager.callFunc("getSceneCount") <= 1 then return false

        m.global.sceneManager.callFunc("popScene")
        return true
    end if

    if key = "options"
        group = m.global.sceneManager.callFunc("getActiveScene")
        if isValid(group) and isValid(group.optionsAvailable) and group.optionsAvailable
            group.lastFocus = group.focusedChild

            ' User opened the menu while on the user avatar
            scene = m.top.getScene()
            if isValid(scene)
                overhang = scene.findNode("overhang")
                if isValid(overhang)
                    overlayCurrentUserSelection = overhang.findNode("overlayCurrentUserSelection")
                    if overlayCurrentUserSelection.visible
                        group.lastFocus = overhang
                    end if
                end if
            end if

            ' Home uses the user avatar to access options
            if group.isSubType("Home") then return true

            panel = group.findNode("options")
            panel.visible = true
            panel.findNode("panelList").setFocus(true)

        end if
        return true
    end if

    if key = KeyCode.REPLAY
        focusAudioMiniPlayer()
        return true
    end if

    return false
end function
