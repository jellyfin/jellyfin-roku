{
  "files": [
    "manifest",
    "source/**/*.*",
    "components/**/*.*",
    "images/**/*.*",
    "locale/**/*.*",
    "settings/*.*"
  ],
  "plugins": ["@rokucommunity/bslint"],
  "diagnosticFilters": [
    {
      "files": "node_modules/**/*"
    },
    {
      "files": "**/roku_modules/**/*"
    }
  ],
  "outDir": "build/staging",
  "compilerOptions": {
    "sourceMap": true,
    "autoImportComponentScript": true
  }
}
