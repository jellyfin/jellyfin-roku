{
  "files": [
    {
      "src": "source/**/!(Main.brs)",
      "dest": "source"
    },
    {
      "src": "components/**/*",
      "dest": "components"
    },
    {
      "src": "locale/**/*",
      "dest": "locale"
    },
    {
      "src": "settings/**/*",
      "dest": "settings"
    },
    "manifest"
  ],
  "diagnosticFilters": [
    {
      "files": "node_modules/**/*"
    },
    {
      "files": "**/roku_modules/**/*"
    }
  ],
  "outDir": "build",
  "plugins": [],
  "compilerOptions": {
    "autoImportComponentScript": true,
    "sourceMap": true
  }
}
